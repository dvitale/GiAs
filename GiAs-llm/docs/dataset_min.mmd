%% Schema application-visible: colonne filtrate da KEEP_COLUMNS (data_sources/base.py)
%% PK riflettono lo schema DB reale. cu_eseguiti_nc e' una MATERIALIZED VIEW.
erDiagram
    masterlist {
        int id PK
        string norma
        string macroarea
        string aggregazione
        string LINEA_DI_ATTIVITA "DB: quoted LINEA DI ATTIVITA"
        string registrati "DB type: character"
        string riconosciuti "DB type: character"
    }
    piani_monitoraggio {
        int id PK
        string sezione
        string alias
        string alias_indicatore
        string descrizione
        string descrizione_2
        boolean campionamento
        boolean is_attivita
    }
    personale {
        int id PK
        string user_id "chiave logica, dedup"
        string descrizione_asl
        string descrizione_uoc
        string descrizione_uos
        string codice_fiscale
        int anno
        string namefirst
        string namelast
    }
    cu_eseguiti_nc["cu_eseguiti_nc (MATERIALIZED VIEW)"] {
        string id_controllo "identificativo logico"
        timestamp data_inizio_controllo
        string alias_piano_attivita FK
        string descrizione_piano
        string alias_indicatore FK
        string descrizione_indicatore
        string macroarea_cu FK
        string aggregazione_cu FK
        string attivita_cu FK
        string sezione
        string descrizione_asl FK
        string descrizione_uoc FK
        string descrizione_uos
        string num_registrazione
        string norma
        string num_riconoscimento
        string latitudine_stab "DB type: text"
        string longitudine_stab "DB type: text"
        string ragione_sociale
        string partita_iva
        string codice_fiscale
        string nominativo_rappresentante
        string tipo_non_conformita
        int numero_nc_gravi
        int numero_nc_non_gravi
        string oggetto_non_conformita
        string comune
    }
    osa_mai_controllati {
        string ragione_sociale "identificativo primario UI"
        string asl
        string macroarea FK
        string aggregazione FK
        string attivita FK
        string comune
        string indirizzo
        string latitudine_stab "DB type: text"
        string longitudine_stab "DB type: text"
        string num_riconoscimento
        string provincia_stab
        string partita_iva
        string codice_fiscale
        string codice_fiscale_rappresentante
        string nominativo_rappresentante
    }
    cu_diff_programmati_eseguiti {
        int id PK
        string indicatore FK
        string descrizione_indicatore
        int anno
        string descrizione_asl FK
        string descrizione_uoc FK
        string descrizione_uos
        int programmati
        int eseguiti
    }

    masterlist ||--o{ cu_eseguiti_nc : "macroarea=macroarea_cu, aggregazione=aggregazione_cu, LINEA DI ATTIVITA=attivita_cu"
    masterlist ||--o{ osa_mai_controllati : "macroarea, aggregazione, attivita"
    piani_monitoraggio ||--o{ cu_eseguiti_nc : "alias, alias_indicatore"
    piani_monitoraggio ||--o{ cu_diff_programmati_eseguiti : "alias_indicatore = indicatore"
    personale ||--o{ cu_eseguiti_nc : "descrizione_asl, descrizione_uoc"
    personale ||--o{ cu_diff_programmati_eseguiti : "descrizione_asl, descrizione_uoc"
